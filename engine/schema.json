              "x_km": {"type": "number", "description": "Straight-line km east of the origin (west is negative)."},
              "y_km": {"type": "number", "description": "Straight-line km north of the origin (south is negative)."},
              "maps": {"type": "array", "items": {"$ref": "#/$defs/id"}},
