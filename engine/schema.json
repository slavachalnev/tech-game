              "time": {"$ref": "#/$defs/text", "description": "e.g. 2½–3 h walk, 1½ h ride"},
              "notes": {"type": "string"}
            }
          }
        }
      }
    },

    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn", "clock_start", "clock_end", "action", "rulings", "narration"],
      "properties": {
        "recipe": {
      "description": "A capability: something the player can now order made again without re-explaining it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "makes", "how", "time", "cost_p", "quality"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
