        "tools": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "Things needed (things/<id>.json)."},
        "people": {"type": "array", "items": {"$ref": "#/$defs/id"}, "description": "Who knows how (people/<id>.json). If they all leave, the recipe is lost."},
        "time": {"$ref": "#/$defs/text", "description": "Per unit or per batch, e.g. 3 weeks per cylinder."},
        "cost_p": {"type": "integer", "minimum": 0, "description": "Per unit: materials and labour."},
        "quality": {"$ref": "#/$defs/props", "description": "What it reliably achieves: tolerances, strength, finish."},
        "flaws": {"$ref": "#/$defs/texts", "description": "Carried into everything made this way."},
        "first_made": {"$ref": "#/$defs/id", "description": "The thing whose making established it."},
        "turn": {"type": "integer", "minimum": 1},
        "historical_year": {"type": "integer"},
        "notes": {"type": "string"}
      }
    },

